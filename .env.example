# ─────────────────────────────────────────────────────────────────────────────
# LeadSync OS — environment configuration
#
# Phase 1 needs NONE of these — the app runs fully on LocalStorage out of the box.
# Add them to enable Phase 2 features. After editing, restart the dev server.
# Anything NEXT_PUBLIC_* is exposed to the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage backend ──────────────────────────────────────────────────────────
# "local" (default) = browser LocalStorage. "supabase" = shared Postgres + auth.
NEXT_PUBLIC_STORAGE_BACKEND=local

# ── Supabase (Phase 2 — shared database, multi-user) ─────────────────────────
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor
# 3. Fill these in and set NEXT_PUBLIC_STORAGE_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI (Phase 2 — outreach drafting & lead summaries) ────────────────────────
# Set EITHER Anthropic (Claude) OR OpenAI. Anthropic wins if both are present.
# Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# AI_PROVIDER=anthropic   # force a vendor; otherwise auto-detected from the keys above

# ── Apollo (Phase 2 — lead sourcing & enrichment) ────────────────────────────
APOLLO_API_KEY=

# ── n8n (Phase 3 — outreach automation & tracking) ───────────────────────────
N8N_WEBHOOK_BASE_URL=
